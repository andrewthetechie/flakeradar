# --- Required ---
# Token CI systems must send in the X-API-Key header and MCP clients in
# Authorization: Bearer. Generate one:
#   openssl rand -base64 32
FLAKERADAR_API_TOKEN=changeme
# The server refuses to start on 'changeme' unless you also set:
# FLAKERADAR_ALLOW_INSECURE=1

# --- Database (PostgreSQL only) ---
# docker compose builds this URL itself from POSTGRES_PASSWORD and POSTGRES_DB,
# and ignores FLAKERADAR_DATABASE_URL; set that only when running the binary
# outside compose.
POSTGRES_PASSWORD=flakeradar
# The database the server uses. When upgrading a 0.1.x compose install, create a
# new one in the same volume and name it here (docs/cutover-rust.md, step 4).
# POSTGRES_DB=flakeradar
# A plain `postgresql://` URL: an old `postgresql+asyncpg://` drops the
# `+asyncpg`, and `?ssl=` becomes `?sslmode=`. The schema is created on first
# start, and the binary refuses a database the 0.1.x server created.
# FLAKERADAR_DATABASE_URL=postgresql://flakeradar:flakeradar@localhost:5432/flakeradar

# --- Bind address ---
# The bare binary binds loopback, because the read APIs are unauthenticated by
# design. The container image sets 0.0.0.0 itself.
# FLAKERADAR_HOST=127.0.0.1
# FLAKERADAR_PORT=8000

# --- Optional: GitHub issue automation (leave blank to disable) ---
# Fine-grained PAT with "Issues: write" on every repo you ingest; issues are
# filed in each flaky test's own repo.
FLAKERADAR_GITHUB_TOKEN=

# Label applied to every auto-filed issue.
FLAKERADAR_GITHUB_ISSUE_LABEL=flakeradar
# Issue-filing gate: a test is filed only when it meets EVERY configured
# (non-zero) minimum below. Set one to 0 to skip that signal entirely, letting
# you tune on score, proven flakes, failures, or any combination. Set all three
# to 0 (with a token) and every touched test would be filed — keep min_score on.
FLAKERADAR_GITHUB_ISSUE_MIN_SCORE=0.30
FLAKERADAR_GITHUB_ISSUE_MIN_PROVEN_FLAKES=0
# Each failed retry attempt counts as one failure for MIN_FAILURES.
FLAKERADAR_GITHUB_ISSUE_MIN_FAILURES=0
# Fixed-note comment: once a linked Test or Job has passed this many runs in a
# row on the default branch, FlakeRadar comments on the issue that the fix
# appears to hold. 0 (default) disables it.
# FLAKERADAR_GITHUB_FIXED_STREAK=0
# Also close the noted issue as completed; the next sync clears the link.
# FLAKERADAR_GITHUB_CLOSE_FIXED=false
# Public base URL of this instance; set it and fixed-note comments and
# notifications link straight to the Test, Job or dashboard.
# FLAKERADAR_PUBLIC_URL=

# --- Optional: Notifications (leave FLAKERADAR_WEBHOOK_URLS empty to disable) ---
# Comma-separated. Every URL gets one request per report that changes a test's
# or job's tier: flaky -> recovered, or the other way.
FLAKERADAR_WEBHOOK_URLS=
# json: a list of event objects. slack: {"text": ...} with one line per event.
FLAKERADAR_WEBHOOK_FORMAT=json

# --- Tuning (defaults shown) ---
# A value outside what its setting means stops the server at start-up with the
# variable's name: a decay or threshold that is not a number from 0 to 1, a score
# window below 1, a negative count or retention window, or a poll of 0.
FLAKERADAR_FLAKE_THRESHOLD=0.30
FLAKERADAR_SCORE_WINDOW=50
FLAKERADAR_SCORE_DECAY=0.85
# A test that has failed on the default branch this many runs in a row is
# broken (not flaky). 0 disables broken detection.
# FLAKERADAR_BROKEN_STREAK=5
# FLAKERADAR_SCORE_HISTORY_RETENTION_DAYS=365
FLAKERADAR_CORS_ORIGINS=http://localhost:5173
