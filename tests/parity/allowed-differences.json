  {
    "id": "junit-unicode-digit-line",
    "differenceRow": "The `line` attribute",
    "reason": "Python's isdigit() accepts Unicode digits, so the Arabic-Indic line in non-numeric-line.xml becomes the line number. The pre-approved rule in differences.md makes Rust accept ASCII digits only and treat anything else as no line, so those two goldens differ in exactly one case's line and nothing else.",
    "allows": [
      {
        "file": "golden/junit/non-numeric-line.line_base0.json",
        "field": "cases.2.line",
        "pythonValue": 13,
        "rustValue": null
      },
      {
        "file": "golden/junit/non-numeric-line.line_base1.json",
        "field": "cases.2.line",
        "pythonValue": 12,
        "rustValue": null
      }
    ]
  },
